# Application
APP_NAME=Prakriti AI API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
JSON_LOGS=false

# API and documentation
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:5173

# Persistence
# SQLite is the default. Replace with a PostgreSQL SQLAlchemy URL when deploying.
DATABASE_URL=sqlite:///./prakriti_ai.db

# Authentication
# Generate a long random value before enabling authentication outside local development.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage. Relative paths are resolved from backend/.
DATASET_DIR=datasets
MODEL_DIR=trained_models
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
